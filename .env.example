PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional MQTT broker for ESP32 telemetry/commands (use TLS broker for deployment)
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DEVICE_ID=field-01
DEVICE_API_KEY=replace-with-a-long-random-device-key
# Coordinates used by weather endpoint (default Chennai, India)
FIELD_LAT=13.0827
FIELD_LON=80.2707
# Safety: live pump control stays disabled until explicitly enabled and hardware interlocks are tested
ALLOW_LIVE_PUMP_CONTROL=false
